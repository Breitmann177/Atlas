#!/usr/bin/env python3
"""Atlas im Terminal. Spricht mit demselben Atlas-Server wie App und Handy (gleiche Chats, Erinnerungen, Werkzeuge).
Terminal-Chats stehen in der App im Ordner "Terminal".

    atlas                 Gespräch starten
    atlas -c              letzten Terminal-Chat fortsetzen
    atlas -r              Terminal-Chats auflisten und einen fortsetzen
    atlas "frage"         eine Frage stellen und fertig

Im Gespräch: /neu  /chats  /weiter <nr>  /modus auto|schnell|gruendlich  /claude  /lokal  /hilfe  /exit
Zeile mit \\ beenden = neue Zeile statt Absenden. Strg+C bricht eine Antwort ab.
"""
import http.cookiejar
import itertools
import json
import os
import re
import shutil
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request

ORDNER = os.path.dirname(os.path.realpath(__file__))
URL = os.environ.get("ATLAS_URL", "http://127.0.0.1:8000")
TTY = sys.stdout.isatty()


def farbe(code):
    return f"\033[{code}m" if TTY else ""


DIM, FETT, KURSIV, AKZENT, CODE, ROT, AUS = (farbe(c) for c in ("2", "1", "3", "38;5;80", "38;5;180", "31", "0"))
STATUS = {"sucht": "sucht im Internet", "liest": "liest", "wetter": "schaut aufs Wetter", "rechnet": "rechnet",
          "denkt nach": "denkt nach"}

kekse = http.cookiejar.CookieJar()
netz = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(kekse))


def anfrage(pfad, daten=None, timeout=10, methode=None):
    req = urllib.request.Request(URL + pfad, data=json.dumps(daten).encode() if daten is not None else None,
                                 headers={"Content-Type": "application/json"}, method=methode)
    return netz.open(req, timeout=timeout)


def env_wert(name):
    try:
        for zeile in open(os.path.join(ORDNER, ".env"), encoding="utf-8"):
            if zeile.strip().startswith(name + "="):
                return zeile.split("=", 1)[1].strip().strip('"').strip("'")
    except OSError:
        pass
    return os.environ.get(name, "")


def server_laeuft():
    try:
        return json.load(anfrage("/auth-status", timeout=1))
    except Exception:
        return None


def server_starten():
    if server_laeuft() is not None:
        return
    print(f"{DIM}Atlas startet ...{AUS}", flush=True)
    if subprocess.run(["systemctl", "--user", "cat", "hermes.service"], capture_output=True).returncode == 0:
        subprocess.run(["systemctl", "--user", "start", "hermes.service"])
    else:
        subprocess.Popen([os.path.join(ORDNER, ".venv/bin/python"), "-m", "uvicorn", "server:app", "--host", "127.0.0.1",
                          "--port", "8000"], cwd=ORDNER, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    for _ in range(120):
        if server_laeuft() is not None:
            return
        time.sleep(0.5)
    sys.exit(f"{ROT}Atlas-Server startet nicht.{AUS}")


def anmelden():
    pw = env_wert("HERMES_PASSWORT")
    if pw:
        try:
            anfrage("/login", {"passwort": pw})
        except urllib.error.HTTPError as e:
            sys.exit(f"{ROT}Anmeldung fehlgeschlagen ({e.code}).{AUS}")


def breite():
    return max(30, min(shutil.get_terminal_size((100, 24)).columns, 110) - 2)


# ---------- Wartesymbol, solange Atlas sucht oder nachdenkt ----------
class Spinner:
    BILDER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

    def __init__(self):
        self.text, self.laeuft, self.faden = "", False, None

    def start(self, text):
        self.text = text
        if not TTY or self.laeuft:
            return
        self.laeuft = True
        self.faden = threading.Thread(target=self._drehen, daemon=True)
        self.faden.start()

    def _drehen(self):
        t0 = time.time()
        for b in itertools.cycle(self.BILDER):
            if not self.laeuft:
                break
            sys.stdout.write(f"\r\033[K{AKZENT}{b}{AUS} {DIM}{self.text} · {time.time() - t0:.0f}s{AUS}")
            sys.stdout.flush()
            time.sleep(0.08)

    def stopp(self):
        if self.laeuft:
            self.laeuft = False
            self.faden.join()
            sys.stdout.write("\r\033[K")
            sys.stdout.flush()


# ---------- Ausgabe: Markdown einfach hübsch, Umbruch nur zwischen Wörtern ----------
class Schreiber:
    EINRUECK = "  "

    def __init__(self):
        self.spalte, self.zeilenanfang, self.wort, self.anfang = 0, True, "", ""
        self.fett = self.code = self.kursiv = False
        self.block = False  # ``` Codeblock
        self.einzug = 0

    def _raus(self, s):
        sys.stdout.write(s)

    def _neue_zeile(self):
        self._raus("\n")
        self.spalte = 0

    def _stil(self):
        return AUS + (FETT if self.fett else "") + (KURSIV if self.kursiv else "") + (CODE if self.code else "")

    def _wort_raus(self):
        w = self.wort
        self.wort = ""
        if not w:
            return
        sichtbar = len(re.sub(r"\*\*|`", "", w))
        if self.spalte + sichtbar > breite() and self.spalte > len(self.EINRUECK) + self.einzug:
            self._neue_zeile()
            self._raus(self.EINRUECK + " " * self.einzug)
            self.spalte = len(self.EINRUECK) + self.einzug
            w = w.lstrip(" ")
        teile = re.split(r"(\*\*|`)", w)
        for t in teile:
            if t == "**":
                self.fett = not self.fett
                self._raus(self._stil())
            elif t == "`":
                self.code = not self.code
                self._raus(self._stil())
            elif t:
                self._raus(t)
                self.spalte += len(t)

    def _zeile_beginnen(self, anfang):
        """Entscheidet am Zeilenanfang über Überschrift, Liste, Codeblock."""
        self._raus(self.EINRUECK)
        self.spalte = len(self.EINRUECK)
        self.einzug = 0
        m = re.match(r"^(#{1,6})\s+", anfang)
        if m:
            self._raus(FETT + AKZENT)
            return anfang[m.end():], True
        m = re.match(r"^(\s*)[-*•]\s+", anfang)
        if m:
            tiefe = len(m.group(1)) // 2
            self._raus("  " * tiefe + f"{AKZENT}•{AUS}{self._stil()} ")
            self.spalte += 2 * tiefe + 2
            self.einzug = 2 * tiefe + 2
            return anfang[m.end():], False
        m = re.match(r"^(\s*)(\d+)[.)]\s+", anfang)
        if m:
            nr = m.group(2) + "."
            self._raus(f"{AKZENT}{nr}{AUS}{self._stil()} ")
            self.spalte += len(nr) + 1
            self.einzug = len(nr) + 1
            return anfang[m.end():], False
        return anfang, False

    def text(self, stueck):
        for z in stueck:
            if self.zeilenanfang:
                if z == "\n":
                    if self.anfang.strip().startswith("```"):
                        self.block = not self.block
                        self.anfang = ""
                        continue
                    self.anfang += z
                    self._zeilenanfang_fertig()
                    continue
                self.anfang += z
                # Genug gesehen, um die Zeilenart zu kennen?
                if len(self.anfang) >= 8 or (z == " " and not re.fullmatch(r"\s*(#{1,6}|[-*•]|\d+[.)])?\s*", self.anfang)):
                    self._zeilenanfang_fertig()
                continue
            self._zeichen(z)

    def _zeilenanfang_fertig(self):
        anfang, self.anfang = self.anfang, ""
        self.zeilenanfang = False
        if self.block:
            self._raus(self.EINRUECK + CODE + anfang.rstrip("\n") + AUS)
            if anfang.endswith("\n"):
                self._raus("\n")
                self.zeilenanfang = True
            self.spalte = len(self.EINRUECK) + len(anfang)
            return
        rest, ueberschrift = self._zeile_beginnen(anfang)
        self.ueberschrift = ueberschrift
        for z in rest:
            self._zeichen(z)

    def _zeichen(self, z):
        if self.block:
            if z == "\n":
                self._raus(AUS + "\n")
                self.zeilenanfang = True
            else:
                self._raus(z)
            return
        if z == "\n":
            self._wort_raus()
            if getattr(self, "ueberschrift", False):
                self.ueberschrift = False
            self.fett = self.kursiv = self.code = False
            self._raus(AUS)
            self._neue_zeile()
            self.zeilenanfang = True
        elif z == " ":
            self._wort_raus()
            self.wort = " "
        else:
            self.wort += z
        sys.stdout.flush()

    def ende(self):
        if self.zeilenanfang and self.anfang:
            self._zeilenanfang_fertig()
        self._wort_raus()
        self._raus(AUS)
        if self.spalte:
            self._raus("\n")
        sys.stdout.flush()


def timer_klingeln(sek):
    time.sleep(sek)
    print(f"\n{AKZENT}{FETT}⏰ Timer abgelaufen!{AUS}\a", flush=True)


class Gespraech:
    def __init__(self):
        self.chat_id, self.modus, self.ki = None, "auto", "lokal"

    def frage(self, text):
        daten = {"text": text, "chat_id": self.chat_id, "modus": self.modus, "ki": self.ki, "quelle": "terminal"}
        spinner, schreiber = Spinner(), Schreiber()
        spinner.start("denkt nach")
        vorschlaege, schrieb = [], False
        try:
            antwort = anfrage("/chat/stream", daten, timeout=600)
            for zeile in antwort:
                try:
                    e = json.loads(zeile)
                except ValueError:
                    continue
                typ = e.get("typ")
                if typ == "start":
                    self.chat_id = e.get("chat_id", self.chat_id)
                elif typ == "status":
                    detail = e.get("detail") or ""
                    if len(detail) > 50:
                        detail = detail[:47] + "..."
                    spinner.text = STATUS.get(e.get("text"), e.get("text")) + (f": {detail}" if detail else "")
                    if not schrieb:
                        spinner.start(spinner.text)
                elif typ == "token":
                    if not schrieb:
                        spinner.stopp()
                        schrieb = True
                    schreiber.text(e.get("text", ""))
                elif typ == "wurf":
                    spinner.stopp()
                    print(f"  {DIM}[{'Münze' if e.get('art') == 'muenze' else 'Würfel'}: {e.get('ergebnis')}]{AUS}")
                elif typ == "timer":
                    threading.Thread(target=timer_klingeln, args=(e.get("sekunden", 0),), daemon=True).start()
                elif typ == "gemerkt":
                    spinner.stopp()
                    print(f"  {DIM}✓ gemerkt: {e.get('fakt')}{AUS}")
                elif typ == "vorschlag":
                    vorschlaege += e.get("fakten", [])
                elif typ == "fehler":
                    spinner.stopp()
                    print(f"  {ROT}{e.get('text')}{AUS}")
        except KeyboardInterrupt:
            spinner.stopp()
            schreiber.ende()
            print(f"  {DIM}(abgebrochen){AUS}")
            return
        except urllib.error.URLError as e:
            spinner.stopp()
            print(f"  {ROT}Keine Verbindung: {e}{AUS}")
            return
        spinner.stopp()
        schreiber.ende()
        for fakt in vorschlaege:
            try:
                if input(f"  {DIM}Merken: „{fakt}“? (j/n) {AUS}").strip().lower().startswith("j"):
                    anfrage("/erinnerungen", {"text": fakt})
                    print(f"  {DIM}✓ gemerkt{AUS}")
            except EOFError:
                break

    def terminal_chats(self):
        try:
            return [c for c in json.load(anfrage("/chats")) if c.get("quelle") == "terminal"]
        except Exception:
            return []

    def chats_zeigen(self):
        chats = self.terminal_chats()[:15]
        if not chats:
            print(f"  {DIM}Noch keine Terminal-Chats.{AUS}")
        for i, c in enumerate(chats, 1):
            print(f"  {AKZENT}{i:>2}{AUS}  {c['titel']}")
        return chats

    def fortsetzen(self, chat):
        self.chat_id = chat["id"]
        try:
            verlauf = json.load(anfrage(f"/chats/{chat['id']}"))
        except Exception:
            verlauf = []
        print(f"  {DIM}── weiter mit „{chat['titel']}“ ──{AUS}")
        for n in verlauf[-4:]:
            text = n["text"].strip().replace("\n", " ")
            text = text if len(text) < 160 else text[:157] + "..."
            wer = f"{FETT}›{AUS}" if n["rolle"] == "user" else f"{AKZENT}●{AUS}"
            print(f"  {wer} {DIM}{text}{AUS}")
        print()

    def befehl(self, text):
        teile = text.split()
        b = teile[0]
        if b in ("/exit", "/quit", "/q"):
            raise EOFError
        if b in ("/neu", "/clear"):
            self.chat_id = None
            print(f"  {DIM}Neuer Chat.{AUS}")
        elif b in ("/chats", "/resume"):
            if self.chats_zeigen():
                print(f"  {DIM}Fortsetzen mit /weiter <nr>{AUS}")
        elif b == "/weiter":
            chats = self.terminal_chats()
            nr = int(teile[1]) if len(teile) > 1 and teile[1].isdigit() else 1
            if 1 <= nr <= len(chats):
                self.fortsetzen(chats[nr - 1])
            else:
                print(f"  {DIM}Diesen Chat gibt es nicht. /chats zeigt alle.{AUS}")
        elif b == "/modus" and len(teile) > 1 and teile[1] in ("auto", "schnell", "gruendlich"):
            self.modus = teile[1]
            print(f"  {DIM}Modus: {self.modus}{AUS}")
        elif b in ("/claude", "/lokal"):
            self.ki = b[1:]
            print(f"  {DIM}KI: {self.ki}{AUS}")
        else:
            print(f"  {DIM}/neu        neuer Chat\n  /chats      Terminal-Chats anzeigen\n  /weiter N   Chat N fortsetzen\n"
                  f"  /modus auto|schnell|gruendlich\n  /claude  /lokal\n  /exit       beenden (oder Strg+D)\n"
                  f"  Zeile mit \\ beenden = neue Zeile. Strg+C bricht eine Antwort ab.{AUS}")


def eingabe():
    """Liest eine Nachricht. Endet eine Zeile mit \\, geht es in der nächsten Zeile weiter."""
    zeilen = []
    while True:
        z = input(f"{AKZENT}{FETT}›{AUS} " if not zeilen else f"{DIM}…{AUS} ")
        if z.endswith("\\"):
            zeilen.append(z[:-1])
            continue
        zeilen.append(z)
        return "\n".join(zeilen).strip()


def kopf():
    b = min(breite(), 60)
    print(f"{AKZENT}╭{'─' * (b - 2)}╮{AUS}")
    titel = f"{FETT}● ● Atlas{AUS}{DIM} im Terminal{AUS}"
    print(f"{AKZENT}│{AUS} {titel}{' ' * (b - 23)}{AKZENT}│{AUS}")
    hilfe = "/hilfe für Befehle · Strg+D beendet"
    print(f"{AKZENT}│{AUS} {DIM}{hilfe}{AUS}{' ' * (b - 3 - len(hilfe))}{AKZENT}│{AUS}")
    print(f"{AKZENT}╰{'─' * (b - 2)}╯{AUS}\n")


def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__)
        return
    server_starten()
    anmelden()
    g = Gespraech()
    if args and args[0] not in ("-c", "-r"):
        g.frage(" ".join(args))
        return
    try:
        import readline
        verlauf = os.path.expanduser("~/.atlas_verlauf")
        try:
            readline.read_history_file(verlauf)
        except OSError:
            pass
        readline.set_history_length(1000)
        import atexit
        atexit.register(readline.write_history_file, verlauf)
    except ImportError:
        pass
    kopf()
    if args[:1] == ["-c"]:
        chats = g.terminal_chats()
        if chats:
            g.fortsetzen(chats[0])
    elif args[:1] == ["-r"]:
        chats = g.chats_zeigen()
        if chats:
            try:
                nr = input(f"  {DIM}Nummer (Enter = neuer Chat): {AUS}").strip()
                if nr.isdigit() and 1 <= int(nr) <= len(chats):
                    g.fortsetzen(chats[int(nr) - 1])
            except (EOFError, KeyboardInterrupt):
                return
        print()
    while True:
        try:
            text = eingabe()
            if not text:
                continue
            print()
            g.befehl(text) if text.startswith("/") else g.frage(text)
            print()
        except KeyboardInterrupt:
            print()
        except EOFError:
            print()
            break


if __name__ == "__main__":
    main()
