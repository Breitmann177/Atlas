#!/usr/bin/env python3
"""Namik im Terminal. Spricht mit demselben Namik-Server wie App und Handy (gleiche Chats, Erinnerungen, Werkzeuge).
Terminal-Chats stehen in der App im Ordner "Terminal".

    namik                 Gespräch starten
    namik -c              letzten Terminal-Chat fortsetzen
    namik -r              Terminal-Chats auflisten und einen fortsetzen
    namik "frage"         eine Frage stellen und fertig

Im Gespräch: /help zeigt alle Befehle. "Wechsel zu Claude" geht auch einfach als Satz.
Zeile mit \\ beenden = neue Zeile statt Absenden. Strg+C bricht eine Antwort ab.
"""
import http.cookiejar
import itertools
import base64
import getpass
import mimetypes
import uuid
import json
import os
import re
import shutil
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request

ORDNER = os.path.dirname(os.path.realpath(__file__))
URL = os.environ.get("NAMIK_URL", os.environ.get("ATLAS_URL", "http://127.0.0.1:8000"))
TTY = sys.stdout.isatty()


def farbe(code):
    return f"\033[{code}m" if TTY else ""


DIM, FETT, KURSIV, AKZENT, CODE, ROT, AUS = (farbe(c) for c in ("2", "1", "3", "38;5;80", "38;5;180", "31", "0"))
STATUS = {"sucht": "sucht im Internet", "liest": "liest", "wetter": "schaut aufs Wetter", "rechnet": "rechnet",
          "denkt nach": "denkt nach"}

kekse = http.cookiejar.CookieJar()
netz = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(kekse))


def anfrage(pfad, daten=None, timeout=10, methode=None):
    req = urllib.request.Request(URL + pfad, data=json.dumps(daten).encode() if daten is not None else None,
                                 headers={"Content-Type": "application/json"}, method=methode)
    return netz.open(req, timeout=timeout)


def env_wert(name):
    try:
        for zeile in open(os.path.join(ORDNER, ".env"), encoding="utf-8"):
            if zeile.strip().startswith(name + "="):
                return zeile.split("=", 1)[1].strip().strip('"').strip("'")
    except OSError:
        pass
    return os.environ.get(name, "")


def server_laeuft():
    try:
        return json.load(anfrage("/auth-status", timeout=1))
    except Exception:
        return None


def server_starten():
    if server_laeuft() is not None:
        return
    print(f"{DIM}Namik startet ...{AUS}", flush=True)
    if subprocess.run(["systemctl", "--user", "cat", "namik.service"], capture_output=True).returncode == 0:
        subprocess.run(["systemctl", "--user", "start", "namik.service"])
    elif subprocess.run(["systemctl", "--user", "cat", "hermes.service"], capture_output=True).returncode == 0:
        subprocess.run(["systemctl", "--user", "start", "hermes.service"])
    else:
        subprocess.Popen([os.path.join(ORDNER, ".venv/bin/python"), "-m", "uvicorn", "server:app", "--host", "127.0.0.1",
                          "--port", "8000"], cwd=ORDNER, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    for _ in range(120):
        if server_laeuft() is not None:
            return
        time.sleep(0.5)
    sys.exit(f"{ROT}Namik-Server startet nicht.{AUS}")


def anmelden():
    pw = env_wert("NAMIK_PASSWORT") or env_wert("HERMES_PASSWORT")
    if pw:
        try:
            anfrage("/login", {"passwort": pw})
        except urllib.error.HTTPError as e:
            sys.exit(f"{ROT}Anmeldung fehlgeschlagen ({e.code}).{AUS}")


def breite():
    return max(30, min(shutil.get_terminal_size((100, 24)).columns, 110) - 2)


# ---------- Wartesymbol, solange Namik sucht oder nachdenkt ----------
class Spinner:
    BILDER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

    def __init__(self):
        self.text, self.laeuft, self.faden = "", False, None

    def start(self, text):
        self.text = text
        if not TTY or self.laeuft:
            return
        self.laeuft = True
        self.faden = threading.Thread(target=self._drehen, daemon=True)
        self.faden.start()

    def _drehen(self):
        t0 = time.time()
        for b in itertools.cycle(self.BILDER):
            if not self.laeuft:
                break
            sys.stdout.write(f"\r\033[K{AKZENT}{b}{AUS} {DIM}{self.text} · {time.time() - t0:.0f}s{AUS}")
            sys.stdout.flush()
            time.sleep(0.08)

    def stopp(self):
        if self.laeuft:
            self.laeuft = False
            self.faden.join()
            sys.stdout.write("\r\033[K")
            sys.stdout.flush()


# ---------- Ausgabe: Markdown einfach hübsch, Umbruch nur zwischen Wörtern ----------
class Schreiber:
    EINRUECK = "  "

    def __init__(self):
        self.spalte, self.zeilenanfang, self.wort, self.anfang = 0, True, "", ""
        self.fett = self.code = self.kursiv = False
        self.block = False  # ``` Codeblock
        self.einzug = 0
        self.link = None
        self.links: list[str] = []

    def _link_raus(self, text, adresse):
        self.links.append(adresse)
        alt, self.link = self.link, None
        for c in text:
            self._zeichen(c)
        ziel = re.sub(r"^https?://(www\.)?", "", adresse).split("/")[0] if adresse.startswith("http") else ""
        if ziel:
            self._wort_raus()
            self.wort = " " + DIM + ziel + AUS + self._stil()
            self._wort_raus()

    def _raus(self, s):
        sys.stdout.write(s)

    def _neue_zeile(self):
        self._raus("\n")
        self.spalte = 0

    def _stil(self):
        return AUS + (FETT if self.fett else "") + (KURSIV if self.kursiv else "") + (CODE if self.code else "")

    def _wort_raus(self):
        w = self.wort
        self.wort = ""
        if not w:
            return
        sichtbar = len(re.sub(r"\*\*|`|\033\[[0-9;]*m", "", w))
        if self.spalte + sichtbar > breite() and self.spalte > len(self.EINRUECK) + self.einzug:
            self._neue_zeile()
            self._raus(self.EINRUECK + " " * self.einzug)
            self.spalte = len(self.EINRUECK) + self.einzug
            w = w.lstrip(" ")
        teile = re.split(r"(\*\*|`)", w)
        for t in teile:
            if t == "**":
                self.fett = not self.fett
                self._raus(self._stil())
            elif t == "`":
                self.code = not self.code
                self._raus(self._stil())
            elif t:
                self._raus(t)
                self.spalte += len(re.sub(r"\033\[[0-9;]*m", "", t))

    def _zeile_beginnen(self, anfang):
        """Entscheidet am Zeilenanfang über Überschrift, Liste, Codeblock."""
        self._raus(self.EINRUECK)
        self.spalte = len(self.EINRUECK)
        self.einzug = 0
        m = re.match(r"^(#{1,6})\s+", anfang)
        if m:
            self._raus(FETT + AKZENT)
            return anfang[m.end():], True
        m = re.match(r"^(\s*)[-*•]\s+", anfang)
        if m:
            tiefe = len(m.group(1)) // 2
            self._raus("  " * tiefe + f"{AKZENT}•{AUS}{self._stil()} ")
            self.spalte += 2 * tiefe + 2
            self.einzug = 2 * tiefe + 2
            return anfang[m.end():], False
        m = re.match(r"^(\s*)(\d+)[.)]\s+", anfang)
        if m:
            nr = m.group(2) + "."
            self._raus(f"{AKZENT}{nr}{AUS}{self._stil()} ")
            self.spalte += len(nr) + 1
            self.einzug = len(nr) + 1
            return anfang[m.end():], False
        return anfang, False

    def text(self, stueck):
        for z in stueck:
            if self.zeilenanfang:
                if z == "\n":
                    if self.anfang.strip().startswith("```"):
                        self.block = not self.block
                        self.anfang = ""
                        continue
                    self.anfang += z
                    self._zeilenanfang_fertig()
                    continue
                self.anfang += z
                # Genug gesehen, um die Zeilenart zu kennen?
                if len(self.anfang) >= 8 or (z == " " and not re.fullmatch(r"\s*(#{1,6}|[-*•]|\d+[.)])?\s*", self.anfang)):
                    self._zeilenanfang_fertig()
                continue
            self._zeichen(z)

    def _zeilenanfang_fertig(self):
        anfang, self.anfang = self.anfang, ""
        self.zeilenanfang = False
        if self.block:
            self._raus(self.EINRUECK + CODE + anfang.rstrip("\n") + AUS)
            if anfang.endswith("\n"):
                self._raus("\n")
                self.zeilenanfang = True
            self.spalte = len(self.EINRUECK) + len(anfang)
            return
        if anfang.strip() in ("---", "***", "___"):  # Trennlinie
            self._raus(self.EINRUECK + DIM + "─" * 24 + AUS + ("\n" if anfang.endswith("\n") else ""))
            self.spalte = 0 if anfang.endswith("\n") else 26
            self.zeilenanfang = anfang.endswith("\n")
            return
        rest, ueberschrift = self._zeile_beginnen(anfang)
        self.ueberschrift = ueberschrift
        for z in rest:
            self._zeichen(z)

    def _zeichen(self, z):
        if self.block:
            if z == "\n":
                self._raus(AUS + "\n")
                self.zeilenanfang = True
            else:
                self._raus(z)
            return
        if self.link is not None:  # [Text](Adresse) sammeln und dann schön ausgeben
            self.link += z
            m = re.fullmatch(r"\[([^\]\n]*)\]\(([^)\s]*)\)", self.link)
            if m:
                self.link = None
                self._link_raus(m.group(1), m.group(2))
            elif z == "\n" or len(self.link) > 400 or re.fullmatch(r"\[[^\]\n]*\][^(]", self.link):
                self._kein_link()
            return
        if z == "[":
            self.link = "["
            return
        self._normal(z)

    def _kein_link(self):
        """War doch kein Link: gesammelten Text normal ausgeben."""
        roh, self.link = self.link, None
        self._normal(roh[0])
        for c in roh[1:]:
            self._zeichen(c)

    def _normal(self, z):
        if z == "\n":
            self._wort_raus()
            if getattr(self, "ueberschrift", False):
                self.ueberschrift = False
            self.fett = self.kursiv = self.code = False
            self._raus(AUS)
            self._neue_zeile()
            self.zeilenanfang = True
        elif z == " ":
            self._wort_raus()
            self.wort = " "
        else:
            self.wort += z
        sys.stdout.flush()

    def ende(self):
        if self.link is not None:
            self._kein_link()
        if self.zeilenanfang and self.anfang:
            self._zeilenanfang_fertig()
        self._wort_raus()
        self._raus(AUS)
        if self.spalte:
            self._raus("\n")
        sys.stdout.flush()


def timer_klingeln(sek):
    time.sleep(sek)
    print(f"\n{AKZENT}{FETT}⏰ Timer abgelaufen!{AUS}\a", flush=True)


EINSTELLUNGEN = os.path.expanduser("~/.config/atlas/terminal.json")
BILD_ENDUNGEN = {".png", ".jpg", ".jpeg", ".webp", ".gif"}


def pdf_hochladen(pfad):
    """Schickt ein PDF an /pdf-lesen (multipart) und gibt {"name", "text"} oder einen Fehlertext zurück."""
    grenze = uuid.uuid4().hex
    name = os.path.basename(pfad).replace('"', "")
    with open(pfad, "rb") as f:
        inhalt = f.read()
    koerper = (f"--{grenze}\r\nContent-Disposition: form-data; name=\"datei\"; filename=\"{name}\"\r\n"
               f"Content-Type: application/pdf\r\n\r\n").encode() + inhalt + f"\r\n--{grenze}--\r\n".encode()
    req = urllib.request.Request(URL + "/pdf-lesen", data=koerper,
                                 headers={"Content-Type": f"multipart/form-data; boundary={grenze}"})
    d = json.load(netz.open(req, timeout=120))
    return d.get("fehler") or {"name": d["name"], "text": d["text"]}


class Gespraech:
    def __init__(self):
        self.chat_id, self.modus, self.ki = None, "auto", "lokal"
        self.bilder, self.dokumente = [], []
        try:
            e = json.load(open(EINSTELLUNGEN, encoding="utf-8"))
            self.modus = e.get("modus") if e.get("modus") in ("auto", "schnell", "gruendlich") else "auto"
            self.ki = "claude" if e.get("ki") == "claude" else "lokal"
        except (OSError, ValueError):
            pass

    def speichern(self):
        try:
            os.makedirs(os.path.dirname(EINSTELLUNGEN), exist_ok=True)
            json.dump({"modus": self.modus, "ki": self.ki}, open(EINSTELLUNGEN, "w", encoding="utf-8"))
        except OSError:
            pass

    def anhaengen(self, pfad):
        pfad = os.path.expanduser(pfad.strip().strip("'\""))
        if not os.path.isfile(pfad):
            print(f"  {ROT}Datei nicht gefunden: {pfad}{AUS}")
            return
        endung = os.path.splitext(pfad)[1].lower()
        if endung in BILD_ENDUNGEN:
            if len(self.bilder) >= 3:
                print(f"  {ROT}Höchstens 3 Bilder pro Nachricht.{AUS}")
                return
            with open(pfad, "rb") as f:
                self.bilder.append(base64.b64encode(f.read()).decode())
        elif endung == ".pdf":
            print(f"  {DIM}Lese PDF ...{AUS}")
            try:
                d = pdf_hochladen(pfad)
            except Exception as e:
                print(f"  {ROT}PDF nicht lesbar: {e}{AUS}")
                return
            if isinstance(d, str):
                print(f"  {ROT}{d}{AUS}")
                return
            self.dokumente.append(d)
        else:
            print(f"  {ROT}Nur Bilder (png, jpg, webp, gif) und PDFs.{AUS}")
            return
        print(f"  {DIM}📎 angehängt: {os.path.basename(pfad)} – jetzt deine Frage dazu schreiben{AUS}")

    def pdfs_speichern(self, links):
        for l in links:
            m = re.fullmatch(r"/pdf/([A-Za-z0-9_-]{1,60}\.pdf)", l)
            if not m:
                continue
            ziel = os.path.join(os.path.expanduser("~/Downloads"), m.group(1))
            try:
                with netz.open(URL + l, timeout=30) as r, open(ziel, "wb") as f:
                    f.write(r.read())
                print(f"  {AKZENT}PDF gespeichert:{AUS} {ziel}")
            except Exception as e:
                print(f"  {ROT}PDF nicht gespeichert: {e}{AUS}")

    def frage(self, text):
        daten = {"text": text, "chat_id": self.chat_id, "modus": self.modus, "ki": self.ki, "quelle": "terminal",
                 "bilder": self.bilder, "dokumente": self.dokumente}
        self.bilder, self.dokumente = [], []
        spinner, schreiber = Spinner(), Schreiber()
        spinner.start("denkt nach")
        vorschlaege, schrieb = [], False
        try:
            antwort = anfrage("/chat/stream", daten, timeout=600)
            for zeile in antwort:
                try:
                    e = json.loads(zeile)
                except ValueError:
                    continue
                typ = e.get("typ")
                if typ == "start":
                    self.chat_id = e.get("chat_id", self.chat_id)
                elif typ == "status":
                    detail = e.get("detail") or ""
                    if len(detail) > 50:
                        detail = detail[:47] + "..."
                    spinner.text = STATUS.get(e.get("text"), e.get("text")) + (f": {detail}" if detail else "")
                    if not schrieb:
                        spinner.start(spinner.text)
                elif typ == "token":
                    if not schrieb:
                        spinner.stopp()
                        schrieb = True
                    schreiber.text(e.get("text", ""))
                elif typ == "wurf":
                    spinner.stopp()
                    print(f"  {DIM}[{'Münze' if e.get('art') == 'muenze' else 'Würfel'}: {e.get('ergebnis')}]{AUS}")
                elif typ == "ki":
                    self.ki = e.get("ki", self.ki)
                    self.speichern()
                    spinner.stopp()
                    print(f"  {DIM}KI jetzt: {'Claude (online)' if self.ki == 'claude' else 'lokal'}{AUS}")
                elif typ == "timer":
                    threading.Thread(target=timer_klingeln, args=(e.get("sekunden", 0),), daemon=True).start()
                elif typ == "gemerkt":
                    spinner.stopp()
                    print(f"  {DIM}✓ gemerkt: {e.get('fakt')}{AUS}")
                elif typ == "vorschlag":
                    vorschlaege += e.get("fakten", [])
                elif typ == "fehler":
                    spinner.stopp()
                    print(f"  {ROT}{e.get('text')}{AUS}")
        except KeyboardInterrupt:
            spinner.stopp()
            schreiber.ende()
            print(f"  {DIM}(abgebrochen){AUS}")
            return
        except urllib.error.URLError as e:
            spinner.stopp()
            print(f"  {ROT}Keine Verbindung: {e}{AUS}")
            return
        spinner.stopp()
        schreiber.ende()
        self.pdfs_speichern(schreiber.links)
        for fakt in vorschlaege:
            try:
                if input(f"  {DIM}Merken: „{fakt}“? (j/n) {AUS}").strip().lower().startswith("j"):
                    anfrage("/erinnerungen", {"text": fakt})
                    print(f"  {DIM}✓ gemerkt{AUS}")
            except EOFError:
                break

    def terminal_chats(self):
        try:
            return [c for c in json.load(anfrage("/chats")) if c.get("quelle") == "terminal"]
        except Exception:
            return []

    def chats_zeigen(self):
        chats = self.terminal_chats()[:15]
        if not chats:
            print(f"  {DIM}Noch keine Terminal-Chats.{AUS}")
        for i, c in enumerate(chats, 1):
            print(f"  {AKZENT}{i:>2}{AUS}  {c['titel']}")
        return chats

    def fortsetzen(self, chat):
        self.chat_id = chat["id"]
        try:
            verlauf = json.load(anfrage(f"/chats/{chat['id']}"))
        except Exception:
            verlauf = []
        print(f"  {DIM}── weiter mit „{chat['titel']}“ ──{AUS}")
        for n in verlauf[-4:]:
            text = n["text"].strip().replace("\n", " ")
            text = text if len(text) < 160 else text[:157] + "..."
            wer = f"{FETT}›{AUS}" if n["rolle"] == "user" else f"{AKZENT}●{AUS}"
            print(f"  {wer} {DIM}{text}{AUS}")
        print()

    BEFEHLE = [
        ("/help", "zeigt alle Befehle (auch /hilfe)"),
        ("/neu", "neuer Chat (auch /clear)"),
        ("/chats", "deine Terminal-Chats anzeigen"),
        ("/weiter <nr>", "Chat Nummer <nr> fortsetzen"),
        ("/modus <art>", "auto, schnell oder gruendlich"),
        ("/ki <wer>", "lokal oder claude"),
        ("/datei <pfad>", "Bild oder PDF an die nächste Frage hängen (oder Datei reinziehen)"),
        ("/schluessel", "Claude-API-Schlüssel eintragen oder entfernen"),
        ("/status", "zeigt KI, Modus und Chat"),
        ("/exit", "beenden (auch Strg+D)"),
    ]

    def hilfe(self):
        print(f"  {FETT}Befehle{AUS}")
        for b, t in self.BEFEHLE:
            print(f"  {AKZENT}{b:<14}{AUS} {DIM}{t}{AUS}")
        print(f"\n  {FETT}Sonst noch{AUS}\n  {DIM}Zeile mit \\ beenden  neue Zeile statt Absenden\n"
              f"  Strg+C               Antwort abbrechen\n  Pfeil hoch           frühere Eingaben\n"
              f"  namik -c / namik -r  letzten Chat fortsetzen / Chat auswählen\n"
              f"  Du kannst auch einfach sagen: „Wechsel zu Claude“ oder „Wechsel zur lokalen KI“.{AUS}")

    def schluessel(self):
        try:
            st = json.load(anfrage("/status"))
        except Exception:
            st = {}
        if st.get("claude"):
            print(f"  {DIM}Gespeichert: sk-ant-…{st.get('claude_ende', '')}{AUS}")
            if input(f"  {DIM}Entfernen? (j/n) {AUS}").strip().lower().startswith("j"):
                anfrage("/claude-schluessel", methode="DELETE")
                self.ki = "lokal"
                self.speichern()
                print(f"  {DIM}Entfernt. KI jetzt: lokal{AUS}")
            return
        print(f"  {DIM}Schlüssel von console.anthropic.com (API Keys). Er wird nur auf dem Laptop gespeichert.{AUS}")
        k = getpass.getpass("  Schlüssel (unsichtbar): ").strip()
        if not k:
            return
        print(f"  {DIM}Prüfe ...{AUS}")
        try:
            anfrage("/claude-schluessel", {"schluessel": k}, timeout=30)
        except urllib.error.HTTPError as e:
            try:
                print(f"  {ROT}{json.load(e).get('detail')}{AUS}")
            except Exception:
                print(f"  {ROT}Fehler {e.code}{AUS}")
            return
        self.ki = "claude"
        self.speichern()
        print(f"  {DIM}Gespeichert. KI jetzt: Claude (online){AUS}")

    def befehl(self, text):
        teile = text.split()
        b = teile[0].lower()
        arg = teile[1].lower() if len(teile) > 1 else ""
        if b in ("/exit", "/quit", "/q"):
            raise EOFError
        if b in ("/help", "/hilfe", "/?", "/h"):
            self.hilfe()
        elif b in ("/neu", "/clear"):
            self.chat_id = None
            print(f"  {DIM}Neuer Chat.{AUS}")
        elif b in ("/chats", "/resume"):
            if self.chats_zeigen():
                print(f"  {DIM}Fortsetzen mit /weiter <nr>{AUS}")
        elif b == "/weiter":
            chats = self.terminal_chats()
            nr = int(arg) if arg.isdigit() else 1
            if 1 <= nr <= len(chats):
                self.fortsetzen(chats[nr - 1])
            else:
                print(f"  {DIM}Diesen Chat gibt es nicht. /chats zeigt alle.{AUS}")
        elif b == "/modus":
            if arg in ("auto", "schnell", "gruendlich"):
                self.modus = arg
                self.speichern()
                print(f"  {DIM}Modus: {self.modus}{AUS}")
            else:
                print(f"  {DIM}Modus ist {self.modus}. Möglich: /modus auto | schnell | gruendlich{AUS}")
        elif b in ("/ki", "/claude", "/lokal"):
            ziel = b[1:] if b != "/ki" else arg
            if ziel not in ("lokal", "claude"):
                print(f"  {DIM}KI ist {self.ki}. Möglich: /ki lokal | claude{AUS}")
            elif ziel == "claude" and not json.load(anfrage("/status")).get("claude"):
                print(f"  {DIM}Noch kein API-Schlüssel. Mit /schluessel eintragen.{AUS}")
            else:
                self.ki = ziel
                self.speichern()
                print(f"  {DIM}KI: {self.ki}{AUS}")
        elif b in ("/datei", "/bild", "/pdf", "/anhang"):
            if len(teile) > 1:
                self.anhaengen(text.split(None, 1)[1])
            else:
                print(f"  {DIM}/datei <pfad>, z. B. /datei ~/Bilder/foto.jpg{AUS}")
        elif b in ("/schluessel", "/key", "/apikey"):
            self.schluessel()
        elif b == "/status":
            print(f"  {DIM}KI: {self.ki} · Modus: {self.modus} · Chat: {self.chat_id or 'neu'}{AUS}")
        else:
            print(f"  {ROT}Unbekannter Befehl {b}{AUS}")
            self.hilfe()


def eingabe():
    """Liest eine Nachricht. Endet eine Zeile mit \\, geht es in der nächsten Zeile weiter."""
    zeilen = []
    while True:
        z = input(f"{AKZENT}{FETT}›{AUS} " if not zeilen else f"{DIM}…{AUS} ")
        if z.endswith("\\"):
            zeilen.append(z[:-1])
            continue
        zeilen.append(z)
        return "\n".join(zeilen).strip()


def augenfarbe():
    """Augenfarbe aus den App-Einstellungen (Design -> Augen von Namik), sonst das gedämpfte Weiß der App."""
    try:
        f = json.load(anfrage("/farben", timeout=2)).get("auge") or "#d9d7cf"
    except Exception:
        f = "#d9d7cf"
    if not TTY or not re.fullmatch(r"#[0-9a-fA-F]{6}", f):
        return ""
    r, g_, b = (int(f[i:i + 2], 16) for i in (1, 3, 5))
    return f"\033[38;2;{r};{g_};{b}m"


def kopf(g):
    """Begrüßungskasten wie bei Claude Code: Logo (die Augen von Namik) links, Infos rechts."""
    ordner = os.getcwd().replace(os.path.expanduser("~"), "~", 1)
    ki = "Claude (online)" if g.ki == "claude" else "lokal"
    rechts = [(f"{FETT}Namik{AUS}{DIM} im Terminal{AUS}", "Namik im Terminal"),
              (f"{DIM}KI: {ki} · Modus: {g.modus}{AUS}", f"KI: {ki} · Modus: {g.modus}"),
              (f"{DIM}{ordner}{AUS}", ordner)]
    a = augenfarbe()
    links = [f"  {a}▄██▄ ▄██▄{AUS}", f"  {a}████ ████{AUS}", f"  {a}▀██▀ ▀██▀{AUS}"]
    innen = max(len(r[1]) for r in rechts) + 15
    innen = min(max(innen, 44), breite() - 2)
    print(f"{AKZENT}╭{'─' * innen}╮{AUS}")
    for l, (farbig, roh) in zip(links, rechts):
        if len(roh) > innen - 16:
            farbig = f"{DIM}…{roh[-(innen - 17):]}{AUS}"
            roh = "…" + roh[-(innen - 17):]
        print(f"{AKZENT}│{AUS}{l}   {farbig}{' ' * (innen - 14 - len(roh))}{AKZENT}│{AUS}")
    print(f"{AKZENT}╰{'─' * innen}╯{AUS}")
    print(f"  {DIM}/help für alle Befehle · Strg+D beendet{AUS}\n")


def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__)
        return
    server_starten()
    anmelden()
    g = Gespraech()
    if args and args[0] not in ("-c", "-r"):
        g.frage(" ".join(args))
        return
    try:
        import readline
        verlauf = os.path.expanduser("~/.atlas_verlauf")
        try:
            readline.read_history_file(verlauf)
        except OSError:
            pass
        readline.set_history_length(1000)
        namen = sorted({b.split()[0] for b, _ in Gespraech.BEFEHLE} | {"/hilfe", "/clear", "/claude", "/lokal"})
        readline.set_completer(lambda t, i: ([n for n in namen if n.startswith(t)] + [None])[i])
        readline.set_completer_delims(" ")
        readline.parse_and_bind("tab: complete")
        import atexit
        atexit.register(readline.write_history_file, verlauf)
    except ImportError:
        pass
    kopf(g)
    if args[:1] == ["-c"]:
        chats = g.terminal_chats()
        if chats:
            g.fortsetzen(chats[0])
    elif args[:1] == ["-r"]:
        chats = g.chats_zeigen()
        if chats:
            try:
                nr = input(f"  {DIM}Nummer (Enter = neuer Chat): {AUS}").strip()
                if nr.isdigit() and 1 <= int(nr) <= len(chats):
                    g.fortsetzen(chats[int(nr) - 1])
            except (EOFError, KeyboardInterrupt):
                return
        print()
    while True:
        try:
            text = eingabe()
            if not text:
                continue
            nackt = text.strip("'\"")
            if nackt.startswith(("/", "~")) and os.path.isfile(os.path.expanduser(nackt)):
                g.anhaengen(nackt)  # Datei ins Terminal gezogen
                continue
            print()
            g.befehl(text) if text.startswith("/") else g.frage(text)
            print()
        except KeyboardInterrupt:
            print()
        except EOFError:
            print()
            break


if __name__ == "__main__":
    main()
